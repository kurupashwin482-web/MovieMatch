# ==========================================================
# MovieMatch Environment Configuration Template
# Anonymous Browser-Based Machine Learning Architecture
# Do NOT commit actual secrets or production keys to Git!
# ==========================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
# Must include https://kurupashwin482-web.github.io for production
CORS_ORIGINS=https://kurupashwin482-web.github.io,http://localhost:5173,http://127.0.0.1:5173

# TMDB API (Optional backend fallback for movie posters/metadata)
TMDB_API_KEY=

# Frontend Configuration (used in frontend/.env)
# In production pointing to Render: https://moviematch-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# ==========================================================
# MovieMatch Environment Configuration Template
# Copy this file to .env and provide your specific values.
# Do NOT commit actual secrets or production keys to Git!
# ==========================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security / JWT Authentication
SECRET_KEY=replace-with-a-very-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite locally, Neon PostgreSQL in production)
DATABASE_URL=sqlite:///./moviematch.db
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/moviematch?sslmode=require

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://kurupashwin482-web.github.io

# TMDB API (Optional backend fallback)
TMDB_API_KEY=

# Frontend Environment (used in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000

# ==========================================================
# MovieMatch Environment Configuration Template
# Copy this file to .env and provide your specific values.
# Do NOT commit actual secrets or production keys to Git!
# ==========================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security / JWT Authentication
# Generate a secure 32+ byte secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# Local development default: SQLite
DATABASE_URL=sqlite:///./moviematch.db
# Production Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/moviematch?sslmode=require

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://kurupashwin482-web.github.io

# TMDB API (Optional: used for fallback poster metadata fetching)
# Keep backend-only, never expose to frontend
TMDB_API_KEY=

# Artifacts and Dataset Paths (Optional overrides, defaults auto-resolve from repository root)
# ARTIFACTS_DIR=../Backend Artifacts
# POPULARITY_PATH=../dataset/processed/popularity_ranking.csv
# METADATA_RAW_PATH=../dataset/raw/movies_metadata.csv

# ==========================================================
# MovieMatch Backend Environment Variables
# ==========================================================

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://kurupashwin482-web.github.io,http://localhost:5173,http://127.0.0.1:5173

# TMDB API (Optional: used for fallback poster metadata fetching)
# Keep backend-only, never expose to frontend
TMDB_API_KEY=
